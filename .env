# ============================================
# DevFlow Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# --------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow_password
POSTGRES_DB=devflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://devflow:devflow_password@localhost:5432/devflow?schema=public

# --------------------------------------------
# Redis
# --------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --------------------------------------------
# pgAdmin (Optional - for database management)
# --------------------------------------------
PGADMIN_EMAIL=admin@devflow.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --------------------------------------------
# Authentication
# --------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-super-secret-auth-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-this-in-production

# --------------------------------------------
# Application
# --------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# --------------------------------------------
# GitHub OAuth (Optional - for GitHub integration)
# --------------------------------------------
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# --------------------------------------------
# Stripe (Optional - for billing)
# --------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# --------------------------------------------
# AI Provider (Optional - for AI features)
# --------------------------------------------
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o-mini

# --------------------------------------------
# File Storage (Optional - for document uploads)
# --------------------------------------------
STORAGE_ENDPOINT=your-storage-endpoint
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
STORAGE_BUCKET=devflow-uploads

# --------------------------------------------
# Email (Optional - for notifications)
# --------------------------------------------
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@devflow.local

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# --------------------------------------------
# Security
# --------------------------------------------
CORS_ORIGIN=http://localhost:3000
